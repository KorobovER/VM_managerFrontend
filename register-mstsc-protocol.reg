Windows Registry Editor Version 5.00

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\URL Scheme Handlers\mstsc]
@="URL:mstsc Protocol"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\URL Scheme Handlers\mstsc\shell\open\command]
@="\"C:\\Windows\\System32\\mstsc.exe\" /v:%1"
